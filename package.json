{
  "name": "@fimbul-works/util-random",
  "description": "Collection of random number generators and utility functions",
  "version": "0.1.5",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "FimbulWorks <contact@fimbul.works>",
  "homepage": "https://github.com/fimbul-works/util-random#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fimbul-works/util-random.git"
  },
  "bugs": {
    "url": "https://github.com/fimbul-works/util-random/issues"
  },
  "keywords": [
    "random",
    "prng",
    "rng",
    "procedural-generation",
    "procgen",
    "functional",
    "utility"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "clean:bundles": "rm -rf bundles",
    "build": "pnpm clean && pnpm build:esm && pnpm build:cjs && pnpm build:docs",
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "build:bundles": "pnpm clean:bundles && tsdown",
    "build:all": "pnpm build && pnpm build:bundles && pnpm sizes",
    "build:docs": "typedoc",
    "format": "npx biome format --write src",
    "test": "vitest",
    "sizes": "npx bundle-size",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@fimbul-works/util-hash": "link:../util-hash"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@fimbul-works/bundle-size": "link:../bundle-size",
    "@types/node": "^25.8.0",
    "tsdown": "^0.22.0",
    "tsx": "^4.22.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
